{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user account profile containing PII, preferences, and account flags.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "village": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120000
        },
        "verified": {
          "type": "boolean"
        },
        "suspended": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi"]
        },
        "termsAccepted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "state", "district", "verified", "suspended", "role", "termsAccepted", "createdAt", "updatedAt"]
    },
    "SellerPublic": {
      "title": "SellerPublic",
      "description": "Publicly readable seller card summary without private email or sensitive PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120000
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "village": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "verified": {
          "type": "boolean"
        },
        "suspended": {
          "type": "boolean"
        },
        "memberSince": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "state", "district", "verified", "suspended", "memberSince", "updatedAt"]
    },
    "Animal": {
      "title": "Animal",
      "description": "Livestock listing document published by a registered seller.",
      "type": "object",
      "properties": {
        "listingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "sellerPhoto": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120000
        },
        "sellerVerified": {
          "type": "boolean"
        },
        "category": {
          "type": "string",
          "enum": ["Cow", "Buffalo", "Goat", "Sheep", "Horse", "Camel", "Donkey", "Poultry", "Other Livestock"]
        },
        "breed": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "age": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "gender": {
          "type": "string",
          "enum": ["Female", "Male", "Pair / Group"]
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "weight": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "milkCapacity": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "healthStatus": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "vaccinationStatus": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "pregnancyStatus": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "price": {
          "type": "number"
        },
        "negotiable": {
          "type": "boolean"
        },
        "photos": {
          "type": "array"
        },
        "videoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "district": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "village": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "locationDescription": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "contactNumber": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "whatsappEnabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SOLD", "INACTIVE", "HIDDEN"]
        },
        "featured": {
          "type": "boolean"
        },
        "views": {
          "type": "number"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["listingId", "sellerId", "sellerName", "category", "breed", "age", "gender", "color", "healthStatus", "vaccinationStatus", "description", "price", "negotiable", "photos", "state", "district", "village", "contactNumber", "status", "featured", "views", "publishedAt", "updatedAt"]
    },
    "Favourite": {
      "title": "Favourite",
      "description": "User saved livestock listing reference.",
      "type": "object",
      "properties": {
        "favouriteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["favouriteId", "userId", "listingId", "createdAt"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Private buyer-to-seller enquiry and reply thread tied to a listing.",
      "type": "object",
      "properties": {
        "enquiryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "listingPhoto": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250000
        },
        "buyerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "buyerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "buyerPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        },
        "sellerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        },
        "reply": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "contactRequested": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "REPLIED", "RESOLVED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["enquiryId", "listingId", "listingTitle", "buyerId", "buyerName", "sellerId", "sellerName", "message", "contactRequested", "status", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification or platform-wide announcement.",
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["NEW_ENQUIRY", "NEW_MESSAGE", "LISTING_PUBLISHED", "LISTING_SOLD", "LISTING_UPDATED", "ADMIN_ANNOUNCEMENT"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "relatedId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["notificationId", "userId", "senderId", "type", "title", "body", "read", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Abuse or policy violation report submitted for a listing.",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reporterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "details": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "REVIEWED", "DISMISSED", "ACTION_TAKEN"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reportId", "listingId", "listingTitle", "reporterId", "reason", "status", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Livestock category managed by platform admins.",
