      "properties": {
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "nameHi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "order": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["categoryId", "nameEn", "nameHi", "slug", "order", "active", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Buyer rating and review of a seller.",
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reviewerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "listingId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "minLength": 2,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reviewId", "sellerId", "reviewerId", "reviewerName", "rating", "comment", "createdAt"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Global platform configuration and announcements.",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "announcementTitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "announcementBody": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "announcementActive": {
          "type": "boolean"
        },
        "supportPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "supportEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["settingId", "announcementActive", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Server-controlled admin authorization record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user profile documents (owner and admin read/write only)."
    },
    "/sellers/{sellerId}": {
      "schema": { "$ref": "#/entities/SellerPublic" },
      "description": "Public seller profile summary for listing cards and seller detail views."
    },
    "/animals/{listingId}": {
      "schema": { "$ref": "#/entities/Animal" },
      "description": "Livestock listings visible publicly when ACTIVE, and manageable by owner or admin."
    },
    "/favourites/{favouriteId}": {
      "schema": { "$ref": "#/entities/Favourite" },
      "description": "User saved animal listings, strictly private to owning user."
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "Private buyer-seller enquiries visible only to buyerId, sellerId, and admins."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Per-user notifications and admin announcements."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "User-submitted listing reports reviewed by admins."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Platform livestock categories."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Buyer reviews of sellers."
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSetting" },
      "description": "Global platform announcements and settings."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Authorized platform administrators."
    }
  }
}
